// ==============================================================================
// rad-tui example 03 — Interactive File Browser
// ==============================================================================

import tui;

fn main() -> i32 {
    var app = App.new();
    app.set_title("Rad File Browser");
    app.init();

    var file_list = List.new();
    file_list.add_item(".. (Parent Directory)");
    file_list.add_item("src/ (Directory)");
    file_list.add_item("tests/ (Directory)");
    file_list.add_item("rad.toml (Package Manifest)");
    file_list.add_item("README.md (Documentation)");
    file_list.add_item("LICENSE (MIT License)");
    file_list.add_item("main.rad (Source File)");

    var selected: usize = 1usize;
    let total_items: usize = 7usize;

    while app.running() {
        let ev = app.poll_event(50);
        if ev.is_quit() {
            app.quit();
        } else if ev.is_key() {
            let k = ev.key;
            if k.code == KEY_UP {
                if selected > 0usize { selected = selected - 1usize; }
                else { selected = total_items - 1usize; }
            } else if k.code == KEY_DOWN {
                if selected + 1usize < total_items { selected = selected + 1usize; }
                else { selected = 0usize; }
            } else if k.is_char(113u8) { // 'q'
                app.quit();
            }
        }

        app.app_clear();
        let term_sz = app.window_size();
        let screen_rect = Rect.new(0, 0, term_sz.cols as i32, term_sz.rows as i32);

        let main_block = Block.new()
            .title(" Rad Commander — Terminal File Explorer ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.cyan()).bold());
        app.draw_block(main_block, screen_rect);

        let inner: Rect = main_block.inner_area(screen_rect);

        // Split into Left Pane (Files 60%) and Right Pane (Preview 40%)
        var panes = Layout.horizontal();
        panes.add_constraint(Constraint.percentage(60));
        panes.add_constraint(Constraint.percentage(40));
        let p_cols = panes.split(inner);

        let left_pane: Rect = get_rect(p_cols, 0usize);
        let right_pane: Rect = get_rect(p_cols, 1usize);

        // Left Pane: File list
        let l_block = Block.new()
            .title(" Directory: . ")
            .border(BORDER_TYPE_PLAIN)
            .border_style(Style.default().fg(Color.white()));
        app.draw_block(l_block, left_pane);
        let l_inner: Rect = l_block.inner_area(left_pane);

        let active_files = file_list.select(selected);
        app.draw_list(active_files, l_inner);

        // Right Pane: File Preview & Info
        let r_block = Block.new()
            .title(" Metadata & Preview ")
            .border(BORDER_TYPE_PLAIN)
            .border_style(Style.default().fg(Color.yellow()));
        app.draw_block(r_block, right_pane);
        let r_inner: Rect = r_block.inner_area(right_pane);

        var preview_text = "Select an item to view metadata.\n\nUse UP/DOWN arrows to navigate.\nPress ENTER to open.\nPress 'q' to quit.";
        if selected == 3usize {
            preview_text = "File: rad.toml\nSize: 184 bytes\nType: Package Manifest\n\n[package]\nname = \"my_app\"\nversion = \"0.1.0\"\nlicense = \"MIT\"";
        } else if selected == 4usize {
            preview_text = "File: README.md\nSize: 1.2 KB\nType: Markdown\n\n# Rad Application\nBuilt with high-performance native Rad standard library.";
        } else if selected == 5usize {
            preview_text = "File: LICENSE\nSize: 1.0 KB\nType: Text\n\nMIT License\nCopyright (c) 2026";
        }

        let preview_p = Paragraph.new(preview_text)
            .paragraph_style(Style.default().fg(Color.green()))
            .align(ALIGN_LEFT);
        app.draw_paragraph(preview_p, r_inner);

        app.render();
    }

    app.finish();
    0
}
