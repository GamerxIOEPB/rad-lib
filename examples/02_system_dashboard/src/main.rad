// ==============================================================================
// rad-tui example 02 — System Monitor Dashboard
// ==============================================================================

import tui;

fn main() -> i32 {
    var app = App.new();
    app.set_title("Rad System Dashboard");
    app.init();

    var cpu_pct = 42;
    var mem_pct = 68;
    var disk_pct = 54;
    var ticks = 0;

    while app.running() {
        let ev = app.poll_event(100);
        if ev.is_quit() {
            app.quit();
        } else if ev.is_key() {
            let k = ev.key;
            if k.is_char(113u8) { // 'q'
                app.quit();
            }
        }

        // Simulate dynamic activity
        ticks = ticks + 1;
        if ticks % 5 == 0 {
            cpu_pct = (cpu_pct + 7) % 95;
            if cpu_pct < 15 { cpu_pct = 25; }
        }

        app.app_clear();
        let term_sz = app.window_size();
        let screen_rect = Rect.new(0, 0, term_sz.cols as i32, term_sz.rows as i32);

        let main_block = Block.new()
            .title(" RadOS Hardware & System Metrics Dashboard (Press 'q' to Exit) ")
            .border(BORDER_TYPE_DOUBLE)
            .border_style(Style.default().fg(Color.cyan()).bold());
        app.draw_block(main_block, screen_rect);

        let inner: Rect = main_block.inner_area(screen_rect);

        // Split inner horizontally into 2 columns: (Metrics 50%, System Info 50%)
        var cols_layout = Layout.horizontal();
        cols_layout.add_constraint(Constraint.percentage(50));
        cols_layout.add_constraint(Constraint.percentage(50));
        let cols = cols_layout.split(inner);

        let left_col: Rect = get_rect(cols, 0usize);
        let right_col: Rect = get_rect(cols, 1usize);

        // Left column: Resource usage bars
        let left_block = Block.new()
            .title(" Resource Utilization ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.green()));
        app.draw_block(left_block, left_col);

        let left_inner: Rect = left_block.inner_area(left_col);
        var res_layout = Layout.vertical();
        res_layout.add_constraint(Constraint.fixed(2)); // CPU label & bar
        res_layout.add_constraint(Constraint.fixed(2)); // Mem label & bar
        res_layout.add_constraint(Constraint.fixed(2)); // Disk label & bar
        let res_rows = res_layout.split(left_inner);

        let r_cpu: Rect = get_rect(res_rows, 0usize);
        let r_mem: Rect = get_rect(res_rows, 1usize);
        let r_disk: Rect = get_rect(res_rows, 2usize);

        let p_cpu = ProgressBar.new(cpu_pct).label("CPU Usage").progress_color(Color.bright_red());
        app.draw_progress(p_cpu, r_cpu);

        let p_mem = ProgressBar.new(mem_pct).label("RAM (10.8 GB / 16.0 GB)").progress_color(Color.yellow());
        app.draw_progress(p_mem, r_mem);

        let p_disk = ProgressBar.new(disk_pct).label("NVMe SSD (486 GB / 900 GB)").progress_color(Color.cyan());
        app.draw_progress(p_disk, r_disk);

        // Right column: Host information & Process status
        let right_block = Block.new()
            .title(" Host Environment ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.magenta()));
        app.draw_block(right_block, right_col);

        let right_inner: Rect = right_block.inner_area(right_col);
        let sys_info = "OS: Linux x86_64 (musl static runtime)\nToolchain: Rad Compiler v0.2.4\nBackend: Native LLVM & Embedded LLD\nUptime: 4 days, 12:34:56\nProcesses: 184 active, 1 running\nNetwork: eth0 10.0.0.42 (1.2 Gbps RX / 450 Mbps TX)\nLoad Average: 0.42, 0.58, 0.65";
        let info_p = Paragraph.new(sys_info)
            .paragraph_style(Style.default().fg(Color.white()))
            .align(ALIGN_LEFT);
        app.draw_paragraph(info_p, right_inner);

        app.render();
    }

    app.finish();
    0
}
