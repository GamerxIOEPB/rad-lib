// ==============================================================================
// rad-tui example 05 — Settings & Configuration Form
// ==============================================================================

import tui;

fn main() -> i32 {
    var app = App.new();
    app.set_title("Rad Settings Form");
    app.init();

    var enable_animations = true;
    var dark_mode = true;
    var sound_fx = false;
    var selected_field = 0; // 0..4

    var status = "Use UP/DOWN to focus option, SPACE to toggle, ENTER on Save.";

    while app.running() {
        let ev = app.poll_event(50);
        if ev.is_quit() {
            app.quit();
        } else if ev.is_key() {
            let k = ev.key;
            if k.code == KEY_UP {
                if selected_field > 0 { selected_field = selected_field - 1; }
                else { selected_field = 3; }
            } else if k.code == KEY_DOWN {
                if selected_field < 3 { selected_field = selected_field + 1; }
                else { selected_field = 0; }
            } else if k.is_char(32u8) { // SPACE
                if selected_field == 0 { enable_animations = !enable_animations; }
                else if selected_field == 1 { dark_mode = !dark_mode; }
                else if selected_field == 2 { sound_fx = !sound_fx; }
            } else if k.code == KEY_ENTER {
                if selected_field == 3 {
                    status = "Settings saved successfully to config.toml!";
                }
            } else if k.is_char(113u8) { // 'q'
                app.quit();
            }
        }

        app.app_clear();
        let term_sz = app.window_size();
        let screen_rect = Rect.new(0, 0, term_sz.cols as i32, term_sz.rows as i32);

        let main_block = Block.new()
            .title(" Preferences & Application Settings (Press 'q' to Quit) ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.cyan()).bold());
        app.draw_block(main_block, screen_rect);

        let inner: Rect = main_block.inner_area(screen_rect);

        var form_layout = Layout.vertical();
        form_layout.add_constraint(Constraint.fixed(2));
        form_layout.add_constraint(Constraint.fixed(2));
        form_layout.add_constraint(Constraint.fixed(2));
        form_layout.add_constraint(Constraint.fixed(3));
        form_layout.add_constraint(Constraint.fixed(2));

        let rows = form_layout.split(inner);
        let r0: Rect = get_rect(rows, 0usize);
        let r1: Rect = get_rect(rows, 1usize);
        let r2: Rect = get_rect(rows, 2usize);
        let r3: Rect = get_rect(rows, 3usize);
        let r4: Rect = get_rect(rows, 4usize);

        var opt1 = "[ ] Smooth UI Animations";
        if enable_animations { opt1 = "[x] Smooth UI Animations"; }
        var s1 = Style.default();
        if selected_field == 0 { s1 = Style.default().bold().reverse(); }
        app.draw_paragraph(Paragraph.new(opt1).paragraph_style(s1), r0);

        var opt2 = "[ ] Dark Mode Color Palette";
        if dark_mode { opt2 = "[x] Dark Mode Color Palette"; }
        var s2 = Style.default();
        if selected_field == 1 { s2 = Style.default().bold().reverse(); }
        app.draw_paragraph(Paragraph.new(opt2).paragraph_style(s2), r1);

        var opt3 = "[ ] Enable Sound Effects & Audio";
        if sound_fx { opt3 = "[x] Enable Sound Effects & Audio"; }
        var s3 = Style.default();
        if selected_field == 2 { s3 = Style.default().bold().reverse(); }
        app.draw_paragraph(Paragraph.new(opt3).paragraph_style(s3), r2);

        let save_btn = Button.new("[ Save & Apply Changes ]")
            .focused(selected_field == 3)
            .button_style(Style.default().fg(Color.black()).bg(Color.green()).bold());
        app.draw_button(save_btn, r3);

        let st_p = Paragraph.new(status)
            .paragraph_style(Style.default().fg(Color.bright_yellow()))
            .align(ALIGN_LEFT);
        app.draw_paragraph(st_p, r4);

        app.render();
    }

    app.finish();
    0
}
