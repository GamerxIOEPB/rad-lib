// ==============================================================================
// rad-tui example 04 — Terminal Pong (Low-Level Canvas 2D Game)
// ==============================================================================

import tui;

fn main() -> i32 {
    var app = App.new();
    app.set_title("Rad Pong Arcade");
    app.init();

    var ball_x = 30;
    var ball_y = 10;
    var vel_x = 1;
    var vel_y = 1;
    var paddle_x = 25;
    let paddle_w = 12;
    var score = 0;

    while app.running() {
        let ev = app.poll_event(40); // 25 FPS
        if ev.is_quit() {
            app.quit();
        } else if ev.is_key() {
            let k = ev.key;
            if k.code == KEY_LEFT || k.is_char(97u8) { // Left or 'a'
                if paddle_x > 2 { paddle_x = paddle_x - 3; }
            } else if k.code == KEY_RIGHT || k.is_char(100u8) { // Right or 'd'
                if paddle_x < 55 { paddle_x = paddle_x + 3; }
            } else if k.is_char(113u8) { // 'q'
                app.quit();
            }
        }

        // Physics step
        ball_x = ball_x + vel_x;
        ball_y = ball_y + vel_y;

        // Bounce walls
        if ball_x <= 2 { ball_x = 2; vel_x = 0 - vel_x; }
        if ball_x >= 68 { ball_x = 68; vel_x = 0 - vel_x; }
        if ball_y <= 2 { ball_y = 2; vel_y = 0 - vel_y; }

        // Paddle collision
        if ball_y >= 18 {
            if ball_x >= paddle_x && ball_x <= paddle_x + paddle_w {
                vel_y = -1;
                score = score + 10;
            } else if ball_y >= 20 {
                // Ball lost: reset
                ball_x = 30;
                ball_y = 10;
                vel_y = 1;
                score = 0;
            }
        }

        app.app_clear();
        let term_sz = app.window_size();
        let screen_rect = Rect.new(0, 0, term_sz.cols as i32, term_sz.rows as i32);

        let arena = Block.new()
            .title(" Rad Arcade: Terminal Pong (Controls: LEFT/RIGHT or A/D, 'q' to Quit) ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.cyan()).bold());
        app.draw_block(arena, screen_rect);

        // Low-level canvas rendering into back buffer directly
        let buf = app.term.back;

        // Draw Arena bounds
        Canvas.draw_rect(buf, 2, 2, 68, 18, 46u8, Style.default().fg(Color.gray()));

        // Draw Ball
        Canvas.draw_char(buf, ball_x, ball_y, 79u8, Style.default().fg(Color.bright_yellow()).bold());

        // Draw Paddle
        Canvas.fill_rect(buf, paddle_x, 19, paddle_w, 1, 61u8, Style.default().fg(Color.green()).bold());

        // Draw Score display
        Canvas.draw_text(buf, 5, 21, "Score: ", Style.default().fg(Color.white()).bold());
        Canvas.draw_char(buf, 12, 21, (48 + (score % 10)) as u8, Style.default().fg(Color.bright_green()).bold());

        app.render();
    }

    app.finish();
    0
}
