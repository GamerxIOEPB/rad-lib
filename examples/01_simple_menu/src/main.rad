// ==============================================================================
// rad-tui example 01 — Simple Interactive Menu
// ==============================================================================

import tui;

fn main() -> i32 {
    var app = App.new();
    app.set_title("Rad Menu Example");
    app.init();

    var menu = List.new();
    menu.add_item("1. Start Game");
    menu.add_item("2. Multiplayer");
    menu.add_item("3. Audio & Video Settings");
    menu.add_item("4. Keybindings & Controls");
    menu.add_item("5. Exit Application");

    var selected: usize = 0usize;
    var status_msg = "Use UP/DOWN to navigate, ENTER to select, 'q' to quit.";

    while app.running() {
        let ev = app.poll_event(50);
        if ev.is_quit() {
            app.quit();
        } else if ev.is_key() {
            let k = ev.key;
            if k.code == KEY_UP {
                if selected > 0usize {
                    selected = selected - 1usize;
                } else {
                    selected = 4usize;
                }
            } else if k.code == KEY_DOWN {
                if selected < 4usize {
                    selected = selected + 1usize;
                } else {
                    selected = 0usize;
                }
            } else if k.code == KEY_ENTER {
                if selected == 0usize {
                    status_msg = "Starting Game... [Press 1-5 or 'q']";
                } else if selected == 1usize {
                    status_msg = "Multiplayer Lobby connected!";
                } else if selected == 2usize {
                    status_msg = "Settings screen opened.";
                } else if selected == 3usize {
                    status_msg = "Controls configuration.";
                } else if selected == 4usize {
                    app.quit();
                }
            } else if k.is_char(113u8) { // 'q'
                app.quit();
            }
        }

        app.app_clear();
        let term_sz = app.window_size();
        let screen_rect = Rect.new(0, 0, term_sz.cols as i32, term_sz.rows as i32);

        // Header
        let block = Block.new()
            .title(" RadTUI Showcase: Interactive Main Menu ")
            .border(BORDER_TYPE_ROUNDED)
            .border_style(Style.default().fg(Color.cyan()).bold());
        app.draw_block(block, screen_rect);

        let inner: Rect = block.inner_area(screen_rect);

        // Split inner area into title, menu list, and footer status
        var layout = Layout.vertical();
        layout.add_constraint(Constraint.fixed(3));
        layout.add_constraint(Constraint.fixed(7));
        layout.add_constraint(Constraint.fixed(3));

        let rows = layout.split(inner);
        let header_rect: Rect = get_rect(rows, 0usize);
        let menu_rect: Rect = get_rect(rows, 1usize);
        let footer_rect: Rect = get_rect(rows, 2usize);

        let title_p = Paragraph.new("Rad Programming Language — High Performance Native TUI")
            .paragraph_style(Style.default().fg(Color.bright_yellow()).bold())
            .align(ALIGN_CENTER);
        app.draw_paragraph(title_p, header_rect);

        let active_menu = menu.select(selected);
        app.draw_list(active_menu, menu_rect);

        let footer_p = Paragraph.new(status_msg)
            .paragraph_style(Style.default().fg(Color.green()).bold())
            .align(ALIGN_LEFT);
        app.draw_paragraph(footer_p, footer_rect);

        app.render();
    }

    app.finish();
    0
}
